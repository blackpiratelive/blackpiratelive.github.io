{{/* Load data from locally fetched JSON file in assets/cinetracker/export.json */}}
{{ $exportData := dict }}
{{ with resources.Get "cinetracker/export.json" }}
  {{ $p := try (. | transform.Unmarshal) }}
  {{ if not $p.Err }}
    {{ $exportData = $p.Value }}
  {{ else }}
    {{ warnf "Failed to unmarshal cinetracker/export.json: %s" $p.Err }}
  {{ end }}
{{ end }}

{{ $watchedMovies := index $exportData "movies" | default (slice) }}
{{ $watchedShows := index $exportData "tv_shows" | default (slice) }}
{{ $episodesList := index $exportData "episodes" | default (slice) }}

{{/* Fetch CMS Movies & TV Shows data for Location & Trip resolution */}}
{{ $cmsUrl := getenv "CMS_API_URL" | default "https://admin-cms-sigma.vercel.app" }}

{{ $cmsMoviesMap := dict }}
{{ $moviesEndpoint := printf "%s/api/movies" (strings.TrimSuffix "/" $cmsUrl) }}
{{ $moviesResult := try (resources.GetRemote $moviesEndpoint) }}
{{ if not $moviesResult.Err }}
  {{ with $moviesResult.Value }}
    {{ $parsedMovies := try (. | transform.Unmarshal (dict "format" "json")) }}
    {{ if not $parsedMovies.Err }}
      {{ range $parsedMovies.Value.movies }}
        {{ if .traktId }}{{ $cmsMoviesMap = merge $cmsMoviesMap (dict (string .traktId) .) }}{{ end }}
        {{ if .tmdbId }}{{ $cmsMoviesMap = merge $cmsMoviesMap (dict (string .tmdbId) .) }}{{ end }}
        {{ if .movieId }}{{ $cmsMoviesMap = merge $cmsMoviesMap (dict (string .movieId) .) }}{{ end }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}

{{ $cmsShowsMap := dict }}
{{ $showsEndpoint := printf "%s/api/shows" (strings.TrimSuffix "/" $cmsUrl) }}
{{ $showsResult := try (resources.GetRemote $showsEndpoint) }}
{{ if not $showsResult.Err }}
  {{ with $showsResult.Value }}
    {{ $parsedShows := try (. | transform.Unmarshal (dict "format" "json")) }}
    {{ if not $parsedShows.Err }}
      {{ range $parsedShows.Value.shows }}
        {{ if .traktId }}{{ $cmsShowsMap = merge $cmsShowsMap (dict (string .traktId) .) }}{{ end }}
        {{ if .tmdbId }}{{ $cmsShowsMap = merge $cmsShowsMap (dict (string .tmdbId) .) }}{{ end }}
        {{ if .showId }}{{ $cmsShowsMap = merge $cmsShowsMap (dict (string .showId) .) }}{{ end }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}

{{ $moviesByDay := dict }}
{{ range $watchedMovies }}
    {{ $dateStr := .watched_date | default .updated_at | default .created_at }}
    {{ if $dateStr }}
        {{ $date := time.AsTime $dateStr }}
        {{ $dayKey := $date.Format "2006-01-02" }}
        {{ $dayMovies := index $moviesByDay $dayKey | default (slice) }}
        {{ $dayMovies = $dayMovies | append . }}
        {{ $moviesByDay = merge $moviesByDay (dict $dayKey $dayMovies) }}
    {{ end }}
{{ end }}

{{/* Process Movies */}}
{{ range $i, $item := $watchedMovies }}
    {{ $title := $item.title }}
    {{ $slug := printf "movies/movie-%s" ($title | urlize) }}
    {{ $tmdbId := int $item.movie_id }}
    {{ $tmdbIdStr := string $tmdbId }}
    {{ $userRating := $item.user_rating }}
    {{ $userReview := $item.user_review }}
    {{ $isFavorite := $item.is_favorite | default false }}
    
    {{ $cmsMovie := index $cmsMoviesMap $tmdbIdStr }}
    {{ $movieLocation := false }}
    {{ $movieTrip := false }}
    {{ $watchLocation := "" }}
    {{ if $cmsMovie }}
      {{ if $cmsMovie.location }}{{ $movieLocation = $cmsMovie.location }}{{ end }}
      {{ if $cmsMovie.trip }}{{ $movieTrip = $cmsMovie.trip }}{{ end }}
      {{ if $cmsMovie.watchLocation }}{{ $watchLocation = $cmsMovie.watchLocation }}{{ end }}
      {{ if and $cmsMovie.personalRating (not $userRating) }}{{ $userRating = $cmsMovie.personalRating }}{{ end }}
      {{ if and $cmsMovie.review (not $userReview) }}{{ $userReview = $cmsMovie.review }}{{ end }}
    {{ end }}

    {{ $dateStr := $item.watched_date | default $item.updated_at | default $item.created_at }}
    {{ $date := time.AsTime $dateStr }}
    {{ $dayKey := $date.Format "2006-01-02" }}
    {{ $dayMovies := index $moviesByDay $dayKey | default (slice) }}
    {{ $feedExclude := gt (len $dayMovies) 2 }}

    {{ $year := 0 }}
    {{ with $item.release_date }}
        {{ $year = (time.AsTime .).Year }}
    {{ end }}

    {{ $page := dict
        "kind" "page"
        "path" $slug
        "title" $title
        "dates" (dict "date" $date)
        "params" (dict 
            "type" "movie"
            "year" $year
            "cinetracker_id" $item.log_id
            "tmdb_id" $tmdbId
            "tagline" ($item.tagline | default "")
            "overview" ($item.overview | default "")
            "rating" ($item.tmdb_vote_average | default 0)
            "user_rating" $userRating
            "user_review" $userReview
            "is_favorite" $isFavorite
            "runtime" ($item.runtime_minutes | default 0)
            "genres" ($item.genres | default slice)
            "last_watched" $dateStr
            "plays" 1
            "feed_exclude" $feedExclude
            "location" $movieLocation
            "trip" $movieTrip
            "watch_location" $watchLocation
        )
        "content" (dict "mediaType" "text/markdown" "value" ($item.overview | default ""))
    }}
    {{ $.AddPage $page }}
{{ end }}

{{ range $dayKey, $movies := $moviesByDay }}
    {{ $sortedMovies := sort $movies "watched_date" "desc" }}
    {{ if gt (len $sortedMovies) 2 }}
        {{ $firstMovie := index $sortedMovies 0 }}
        {{ $dateStr := $firstMovie.watched_date | default $firstMovie.updated_at | default $firstMovie.created_at }}
        {{ $date := time.AsTime $dateStr }}
        {{ $feedItems := slice }}
        {{ range first 2 $sortedMovies }}
            {{ $movieURL := printf "/movies/movie-%s/" (.title | urlize) }}
            {{ $year := 0 }}
            {{ with .release_date }}
                {{ $year = (time.AsTime .).Year }}
            {{ end }}
            {{ $feedItems = $feedItems | append (dict "title" .title "url" $movieURL "year" $year "tmdb_id" (int .movie_id) "type" "movie") }}
        {{ end }}

        {{ $page := dict
            "kind" "page"
            "path" (printf "feed/movies-%s" $dayKey)
            "title" (printf "Watched %d movies" (len $sortedMovies))
            "dates" (dict "date" $date)
            "params" (dict
                "feed_type" "movies"
                "feed_items" $feedItems
                "remaining" (sub (len $sortedMovies) 2)
                "total" (len $sortedMovies)
                "hidden" true
            )
            "content" (dict "mediaType" "text/markdown" "value" "")
        }}
        {{ $.AddPage $page }}
    {{ end }}
{{ end }}

{{/* Process Shows */}}
{{ range $i, $item := $watchedShows }}
    {{ $title := $item.name }}
    {{ $slug := printf "shows/show-%s" ($title | urlize) }}
    {{ $tmdbId := int $item.tv_show_id }}
    {{ $tmdbIdStr := string $tmdbId }}
    {{ $userRating := $item.user_rating }}
    {{ $userReview := $item.user_review }}
    {{ $isFavorite := $item.is_favorite | default false }}
    
    {{ $cmsShow := index $cmsShowsMap $tmdbIdStr }}
    {{ $showLocation := false }}
    {{ $showTrip := false }}
    {{ if $cmsShow }}
      {{ if $cmsShow.location }}{{ $showLocation = $cmsShow.location }}{{ end }}
      {{ if $cmsShow.trip }}{{ $showTrip = $cmsShow.trip }}{{ end }}
      {{ if and $cmsShow.personalRating (not $userRating) }}{{ $userRating = $cmsShow.personalRating }}{{ end }}
      {{ if and $cmsShow.review (not $userReview) }}{{ $userReview = $cmsShow.review }}{{ end }}
    {{ end }}

    {{ $dateStr := $item.updated_at | default $item.end_date | default $item.start_date | default $item.created_at }}
    {{ $date := time.AsTime $dateStr }}

    {{ $seasonsWatched := $item.number_of_seasons | default 1 }}
    {{ $totalEpisodes := $item.number_of_episodes | default 1 }}
    {{ $epRuntime := int ($item.runtime_minutes | default 30) }}
    {{ $totalRuntime := mul $totalEpisodes $epRuntime }}

    {{ $year := 0 }}
    {{ with $item.first_air_date }}
        {{ $year = (time.AsTime .).Year }}
    {{ end }}

    {{ $page := dict
        "kind" "page"
        "path" $slug
        "title" $title
        "dates" (dict "date" $date)
        "params" (dict 
            "type" "show"
            "year" $year
            "cinetracker_id" $item.log_id
            "tmdb_id" $tmdbId
            "overview" ($item.overview | default "")
            "status" ($item.status | default "")
            "is_completed" ($item.is_completed | default false)
            "rating" ($item.tmdb_vote_average | default 0)
            "user_rating" $userRating
            "user_review" $userReview
            "is_favorite" $isFavorite
            "runtime" $totalRuntime
            "ep_runtime" $epRuntime
            "genres" ($item.genres | default slice)
            "last_watched" $dateStr
            "seasons_watched" $seasonsWatched
            "episodes_watched" $totalEpisodes
            "location" $showLocation
            "trip" $showTrip
        )
        "content" (dict "mediaType" "text/markdown" "value" ($item.overview | default ""))
    }}
    {{ $.AddPage $page }}
{{ end }}

{{/* Process Episodes for Feed */}}
{{ $episodesByDay := dict }}
{{ range $episodesList }}
    {{ $dateStr := .watched_date | default .updated_at | default .created_at }}
    {{ if $dateStr }}
        {{ $date := time.AsTime $dateStr }}
        {{ $dayKey := $date.Format "2006-01-02" }}
        {{ $dayEpisodes := index $episodesByDay $dayKey | default (slice) }}
        {{ $showURL := printf "/shows/show-%s/" (.tv_show_name | urlize) }}
        {{ $episode := dict
            "date" $date
            "show_title" .tv_show_name
            "show_url" $showURL
            "season" (int .season_number)
            "episode_number" (int .episode_number)
            "tmdb_id" (int .tv_show_id)
            "type" "show"
        }}
        {{ $dayEpisodes = $dayEpisodes | append $episode }}
        {{ $episodesByDay = merge $episodesByDay (dict $dayKey $dayEpisodes) }}
    {{ end }}
{{ end }}

{{ range $dayKey, $episodes := $episodesByDay }}
    {{ $sortedEpisodes := sort $episodes "date" "desc" }}
    {{ if gt (len $sortedEpisodes) 2 }}
        {{ $firstEpisode := index $sortedEpisodes 0 }}
        {{ $feedItems := slice }}
        {{ range first 2 $sortedEpisodes }}
            {{ $feedItems = $feedItems | append (dict "show_title" .show_title "show_url" .show_url "season" .season "episode_number" .episode_number "tmdb_id" .tmdb_id "type" "show") }}
        {{ end }}

        {{ $page := dict
            "kind" "page"
            "path" (printf "feed/episodes-%s" $dayKey)
            "title" (printf "Watched %d episodes" (len $sortedEpisodes))
            "dates" (dict "date" $firstEpisode.date)
            "params" (dict
                "feed_type" "episodes"
                "feed_items" $feedItems
                "remaining" (sub (len $sortedEpisodes) 2)
                "total" (len $sortedEpisodes)
                "hidden" true
            )
            "content" (dict "mediaType" "text/markdown" "value" "")
        }}
        {{ $.AddPage $page }}
    {{ else }}
        {{ range $sortedEpisodes }}
            {{ $page := dict
                "kind" "page"
                "path" (printf "feed/episode-%s-s%02de%02d-%s" (.show_title | urlize) .season .episode_number $dayKey)
                "title" (printf "%s S%02dE%02d" .show_title .season .episode_number)
                "dates" (dict "date" .date)
                "params" (dict
                    "feed_type" "episode"
                    "show_title" .show_title
                    "show_url" .show_url
                    "season" .season
                    "episode_number" .episode_number
                    "tmdb_id" .tmdb_id
                    "type" "show"
                    "hidden" true
                )
                "content" (dict "mediaType" "text/markdown" "value" "")
            }}
            {{ $.AddPage $page }}
        {{ end }}
    {{ end }}
{{ end }}

{{/* Fetch published microblog posts directly from CMS site API */}}
{{ $endpoint := printf "%s/api/microblogs" (strings.TrimSuffix "/" $cmsUrl) }}

{{ $result := try (resources.GetRemote $endpoint) }}

{{ if $result.Err }}
  {{ warnf "Failed to fetch content from CMS: %s" $result.Err }}
{{ else }}
  {{ with $result.Value }}
    {{ $parsed := try (. | transform.Unmarshal (dict "format" "json")) }}
    {{ if $parsed.Err }}
      {{ warnf "CMS Adapter Parse Error: %s (content-type: %s)" $parsed.Err .MediaType.Type }}
    {{ else }}
      {{ $json := $parsed.Value }}
      {{ range $json.posts }}
        {{ $id := .id }}
        {{ $slug := .slug }}
        {{ $markdown := .contentMarkdown }}
        {{ $publishedAt := .publishedAt }}
        {{ $tags := .tags }}
        {{ $coverImageUrl := .coverImageUrl }}
        {{ $images := .images }}
        {{ $relatedPosts := .relatedPosts }}
        {{ $location := .location }}
        {{ $trip := .trip }}

        {{ $pageData := dict
            "kind" "page"
            "path" (printf "thoughts/%s" $slug)
            "title" ""
            "dates" (dict "date" (time.AsTime $publishedAt))
            "params" (dict "slug" $slug "tags" $tags "cover_image_url" $coverImageUrl "images" $images "related_posts" $relatedPosts "location" $location "trip" $trip "is_microblog" true)
            "content" (dict "mediaType" "text/markdown" "value" $markdown)
        }}

        {{/* Construct Hugo Page under /thoughts/<slug>/ */}}
        {{ $.AddPage $pageData }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}

